{
  "name": "callmissed-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm test && npm run build && npm run test:runtime",
    "test:runtime": "node scripts/runtime-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/capture.mjs"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.99.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.25.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "miniflare": "^5.20260926.0-alpha",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.75.0"
  }
}
